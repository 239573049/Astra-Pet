<Project>
  <!-- 所有项目共用的设置。各项目只写自己特有的东西。 -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 版本号：发布时由 GitHub 工作流用 -p:Version=x.y.z 覆盖（全局属性，所有项目一起变），更新检测拿它和服务器上的最新版本比较。 -->
    <Version>0.1.3</Version>
    <Product>Astra Pet</Product>
    <Authors>RoutinAI</Authors>
    <Company>RoutinAI</Company>
    <RepositoryUrl>https://github.com/239573049/Astra-Pet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 RoutinAI (https://routin.ai). Source code: MIT. Pet artwork: all rights reserved, see LICENSE-ASSETS.md.</Copyright>

    <!-- 更新服务器：LocalGate 官网，固定是这个地址。用户可以在控制台里改成别的；构建时也能用 -p:UpdateBaseUrl=https://… 覆盖。
         由 AstraPet.Core 写进 BuildInfo 常量（见它的 GenerateBuildInfo）。 -->
    <UpdateBaseUrl Condition="'$(UpdateBaseUrl)' == ''">https://astra-gate.si</UpdateBaseUrl>

    <!-- NativeAOT：编译期就把裁剪和 AOT 的问题报出来，不要等到运行时才炸。 -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- 共享素材目录（宠物动画、图标、模型库）。各项目按需链接，素材只有一份，路径和许可文件里写的一致。 -->
    <AstraAssets>$(MSBuildThisFileDirectory)src\Assets\</AstraAssets>
  </PropertyGroup>
</Project>
