<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:local="using:AstraPet.ControlPanel"
             xmlns:imp="using:AstraPet.Import"
             x:Class="AstraPet.ControlPanel.ProviderDialogs"
             x:DataType="local:ProvidersViewModel">
    <!--
    提供商的三个对话框（选择、新增 / 编辑、导入），都是 Arc 的 Dialog：画在窗口的浮层上，自带遮罩、模糊、
    Esc / 点遮罩 / 右上角关闭和焦点圈定。IsOpen 双向绑到视图模型，关掉时视图模型清理草稿。
    -->
    <UserControl.Styles>
        <Style Selector="Border.icontile">
            <!-- 品牌图标多是深色线稿，统一垫一块固定的浅色底，深浅主题下都看得清 -->
            <Setter Property="Background" Value="#F1F3F2" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
        </Style>
        <Style Selector="Border.icontile.small">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8 3" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="Margin" Value="2 16 0 8" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!--
        整行可点的磁贴：预设、导入来源。Arc 的 Button 会把内容居中、只适合文字标签，
        这里用普通 Button 配 Arc 的令牌：内容靠左，悬停描边变深，按下微缩，键盘焦点有焦点环。
        -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ Border#Surface">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.tile:focus-visible /template/ Border#Surface">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Button.tile:disabled">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ───── 选择提供商 ───── -->
        <arc:Dialog Size="Large" IsOpen="{Binding IsPicker, Mode=TwoWay}"
                    Title="添加提供商" Description="选一个服务商，地址和模型会自动填好。列表里没有的，选「自定义」。"
                    CloseButtonName="关闭">
            <Grid RowDefinitions="Auto,*,Auto" Height="420">
                <arc:Input Text="{Binding Search, Mode=TwoWay}" PlaceholderText="搜索服务商，例如 deepseek、千问、openai" AutomationProperties.Name="搜索提供商" />
                <!-- 右边留出滚动条的位置，别压在磁贴上 -->
                <ScrollViewer x:Name="PickerScroll" Grid.Row="1" Margin="0 6 -12 0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0 0 12 8">
                        <TextBlock Text="没有匹配的提供商，试试「自定义 · OpenAI 兼容」。" Classes="note" Margin="0 18 0 0" IsVisible="{Binding NoPresetMatch}" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PresetGroup">
                                    <StackPanel>
                                        <TextBlock Classes="group" Text="{Binding Title}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PresetItem">
                                                    <Button Classes="tile" Tag="{Binding}" Click="OnPickPreset"
                                                            AutomationProperties.Name="{Binding Name}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border Classes="icontile small">
                                                                <Grid>
                                                                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="20" Height="20"
                                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                    <TextBlock Text="{Binding Glyph}" IsVisible="{Binding !HasIcon}" Foreground="#2B332F"
                                                                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="mono" Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <!-- 底部一行：模型库的来源和更新 -->
                <Border Grid.Row="2" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0 1 0 0" Padding="0 10 0 0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="note" Text="{Binding CatalogLine}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Center" ToolTip.Tip="地址、模型列表和模型参数（上下文、最大输出、价格）来自 models.dev" />
                        <arc:Button Grid.Column="1" Variant="Ghost" Size="Small" Content="{Binding CatalogUpdateText}"
                                    Click="OnUpdateCatalog" IsLoading="{Binding CatalogUpdating}" />
                    </Grid>
                </Border>
            </Grid>
        </arc:Dialog>

        <!-- ───── 新增 / 编辑 ───── -->
        <!-- 表单可能填了一半，点遮罩不关；Esc 和右上角照常。 -->
        <arc:Dialog Size="Large" IsOpen="{Binding IsForm, Mode=TwoWay}" CloseOnOutsidePress="False"
                    Title="{Binding FormTitle}" Description="{Binding FormSubtitle}" CloseButtonName="关闭">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="430" Margin="0 0 -12 0">
                <StackPanel Spacing="16" Margin="0 0 12 4">
                    <arc:Input Label="名称" Text="{Binding Draft.Name, Mode=TwoWay}" PlaceholderText="给这个配置起个名字" />

                    <StackPanel Spacing="6">
                        <TextBlock Classes="field" Text="协议" />
                        <arc:Select ItemsSource="{Binding ProtocolList}" SelectedItem="{Binding DraftProtocol, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="协议" />
                        <TextBlock Text="{Binding ProtocolHint}" Classes="note" />
                    </StackPanel>

                    <arc:Input Label="接口地址" Text="{Binding Draft.BaseUrl, Mode=TwoWay}" PlaceholderText="https://api.example.com/v1" />

                    <StackPanel Spacing="4">
                        <arc:PasswordField Label="API Key" Text="{Binding Draft.ApiKey, Mode=TwoWay}" Placeholder="sk-…（本地模型可留空）" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasKeyUrl}">
                            <TextBlock Text="Key 只保存在本机的设置文件里。" Classes="note" VerticalAlignment="Center" />
                            <arc:Button Grid.Column="1" Variant="Ghost" Size="Small" Content="去获取 API Key ↗" Click="OnOpenKeyUrl" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="field" Text="模型" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <arc:Input Text="{Binding Draft.Model, Mode=TwoWay}" PlaceholderText="模型名，例如 gpt-4o-mini" AutomationProperties.Name="模型" />
                            <arc:Button Grid.Column="1" Content="获取模型" Click="OnFetchModels" IsLoading="{Binding Fetching}"
                                        ToolTip.Tip="向接口请求可用的模型列表" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ModelSuggestions}" IsVisible="{Binding HasModelSuggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <arc:Button Variant="Secondary" Size="Small" Tag="{Binding}" Click="OnPickModel">
                                        <TextBlock Text="{Binding}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="11" />
                                    </arc:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ModelInfoText}" Classes="note" IsVisible="{Binding HasModelInfo}" ToolTip.Tip="模型参数来自 models.dev" />
                        <TextBlock Text="{Binding ModelSuggestNote}" Classes="note" IsVisible="{Binding ModelSuggestNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding FetchText}" Classes="note" Classes.ok="{Binding FetchOk}" Classes.err="{Binding !FetchOk}"
                                   IsVisible="{Binding HasFetchText}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="field" Text="工具调用（让宠物做动作）" />
                        <arc:Select ItemsSource="{Binding ToolSupportList}" SelectedItem="{Binding DraftToolSupport, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="工具调用" />
                        <TextBlock Text="{Binding ToolSupportHint}" Classes="note" TextWrapping="Wrap" />
                    </StackPanel>

                    <arc:Alert Content="{Binding PresetHint}" IsVisible="{Binding HasPresetHint}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <SelectableTextBlock Text="{Binding FormTestText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                             Classes.ok="{Binding FormTestOk}" Classes.err="{Binding !FormTestOk}" />
                        <arc:Button Grid.Column="1" Content="测试连接" Click="OnTestDraft" IsLoading="{Binding FormTesting}"
                                    ToolTip.Tip="发送一条 “Say 1” 请求，再测一次工具调用" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:Button Content="{Binding DeleteText}" Variant="Danger" Click="OnDeleteProvider" IsVisible="{Binding IsEditing}" />
                    <arc:Button Content="重新选择" Variant="Ghost" Click="OnBackToPicker" IsVisible="{Binding !IsEditing}" />
                    <arc:Button Content="取消" Click="OnClose" />
                    <arc:Button Variant="Primary" Content="{Binding SaveText}" Click="OnSave" IsEnabled="{Binding CanSave}" IsDefault="True" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <!-- ───── 从其他应用导入 ───── -->
        <arc:Dialog Size="Large" IsOpen="{Binding IsImport, Mode=TwoWay}"
                    Title="{Binding ImportTitle}" Description="{Binding ImportDescription}" CloseButtonName="关闭">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="400" Margin="0 0 -12 0">
                <StackPanel Spacing="8" Margin="0 0 12 4">
                    <arc:Alert Tone="Danger" Content="{Binding ImportError}" IsVisible="{Binding HasImportError}" />

                    <!-- 来源列表 -->
                    <ItemsControl ItemsSource="{Binding Sources}" IsVisible="{Binding IsImportList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ImportSourceItem">
                                <Button Classes="tile" Tag="{Binding}" Click="OnOpenSource" IsEnabled="{Binding CanOpen}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Classes="icontile">
                                            <Grid>
                                                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="22" Height="22"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                <TextBlock Text="{Binding Glyph}" IsVisible="{Binding !HasIcon}" Foreground="#2B332F"
                                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Classes="mono" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Classes="note" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="14" IsVisible="{Binding CanOpen}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 某个来源里的提供商 -->
                    <ItemsControl ItemsSource="{Binding ImportCandidates}" IsVisible="{Binding IsImportDetail}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="imp:ImportCandidate">
                                <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12 10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <arc:Checkbox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                      VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <arc:Badge Size="Small" Content="{Binding Source}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Classes="note" Text="{Binding Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Classes="mono" Text="{Binding KeyMask}" HorizontalAlignment="Right" />
                                            <arc:Badge Size="Small" Tone="Warning" Content="已存在" HorizontalAlignment="Right" IsVisible="{Binding Duplicate}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:Button Content="选择配置文件…" Variant="Ghost" Click="OnPickFile" IsVisible="{Binding IsImportList}"
                                ToolTip.Tip="默认位置找不到时，手动选 cc-switch.db、config.toml、auth.json、settings.json 或 .credentials.yaml" />
                    <arc:Button Content="全选" Variant="Ghost" Click="OnSelectAll" IsVisible="{Binding IsImportDetail}" />
                    <arc:Button Content="全不选" Variant="Ghost" Click="OnSelectNone" IsVisible="{Binding IsImportDetail}" />
                    <arc:Button Content="关闭" Click="OnClose" IsVisible="{Binding IsImportList}" />
                    <arc:Button Content="返回" Click="OnBackToSources" IsVisible="{Binding IsImportDetail}" />
                    <arc:Button Variant="Primary" Content="{Binding ImportButtonText}" Click="OnImportSelected"
                                IsVisible="{Binding IsImportDetail}" IsEnabled="{Binding CanImport}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>
    </Panel>
</UserControl>
