<Project Sdk="Microsoft.NET.Sdk">
  <!--
    基础设施：和外部世界打交道的实现——大模型 HTTP 客户端、从其他应用导入提供商、下载更新包。
    只依赖 Core，不引用 Avalonia。
  -->
  <PropertyGroup>
    <RootNamespace>AstraPet</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstraPet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置的模型参数库，来自 models.dev，见 tools/fetch_models_dev.py。ModelCatalog 在这个程序集里读它。 -->
    <EmbeddedResource Include="$(AstraAssets)models.dev.json" LogicalName="models.dev.json" Link="Assets\models.dev.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstraPet.Core\AstraPet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 从其他应用导入提供商：CC Switch 是 SQLite，Codex 是 TOML，DeepSeek Harness 是 YAML。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
