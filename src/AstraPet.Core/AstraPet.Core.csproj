<Project Sdk="Microsoft.NET.Sdk">
  <!--
    核心层：领域模型、设置、动画状态机、更新检测。只依赖 BCL，不引用 Avalonia、不引用平台层。
    注意：ClipStream / PetClip（起 ffmpeg）、UpdateChecker / ModelCatalog（发 HTTP）按设计属于基础设施，
    要等重构第 3 步引入 IFrameSource 等接口后才能挪出去，见 design/04-migration.md。
  -->
  <PropertyGroup>
    <RootNamespace>AstraPet.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstraPet.Tests" />
  </ItemGroup>

  <!-- 版本号和更新服务器地址写成常量，不靠 Assembly.GetCustomAttributes 反射读：NativeAOT 下那条路会因为元数据被裁掉而读不到。 -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <BuildInfoSource>namespace AstraPet.Core%3B internal static class BuildInfo { public const string Version = "$(Version)"%3B public const string UpdateBaseUrl = "$(UpdateBaseUrl)"%3B }</BuildInfoSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="$(BuildInfoSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- 内置的模型参数库，来自 models.dev，见 tools/fetch_models_dev.py。ModelCatalog 在这个程序集里读它。 -->
    <EmbeddedResource Include="$(AstraAssets)models.dev.json" LogicalName="models.dev.json" Link="Assets\models.dev.json" />
  </ItemGroup>
</Project>
